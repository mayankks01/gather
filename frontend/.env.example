# Local development: leave unset; Vite proxies to localhost:5080.
# Vercel: set both variables in Project Settings > Environment Variables.
# VITE_BACKEND_ORIGIN=https://your-api.example.com
# GATHER_PROXY_SECRET=generate-a-random-secret-of-at-least-32-characters
# GATHER_PROXY_SECRET is server-only. Never prefix it with VITE_.
