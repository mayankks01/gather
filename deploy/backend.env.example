# Set these in your Docker hosting provider's environment/secret settings.
# Do not commit a filled-in copy. No value below is a usable secret.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
App__PublicUrl=https://your-gather-project.vercel.app
Jwt__Key=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
Proxy__VercelSecret=REPLACE_WITH_ANOTHER_RANDOM_64_HEX_CHARACTERS
Email__Host=smtp.your-email-provider.example
Email__Port=587
Email__Security=StartTls
Email__From=Gather <noreply@your-verified-domain.example>
Email__Username=REPLACE_WITH_SMTP_USERNAME
Email__Password=REPLACE_WITH_SMTP_PASSWORD
# SQLite pilot: mount a persistent, writable disk at /app/App_Data.
Database__Provider=Sqlite
ConnectionStrings__Gather=Data Source=/app/App_Data/gather.db
# Optional PostgreSQL instead (still mount App_Data for media + encryption keys):
# Database__Provider=Postgres
# ConnectionStrings__Gather=Host=HOST;Port=5432;Database=gather;Username=USER;Password=PASSWORD;SSL Mode=VerifyFull
# Optional: trust ONLY your host's documented immediate reverse proxy IPs/CIDRs.
# Proxy__KnownProxies=10.0.0.5
# Proxy__KnownNetworks=10.0.0.0/24
# Never set ASPNETCORE_FORWARDEDHEADERS_ENABLED=true or trust 0.0.0.0/0.
Storage__UserQuotaBytes=536870912
Storage__TotalQuotaBytes=5368709120
Storage__MinimumFreeBytes=268435456
Storage__UnattachedHours=24
