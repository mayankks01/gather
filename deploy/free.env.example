# Render Free backend. Paste values into Render's Environment settings; replace ALL placeholders.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
PORT=8080
Hosting__Ephemeral=true
App__PublicUrl=https://your-project.vercel.app
Jwt__Key=GENERATE_A_RANDOM_64_HEX_CHARACTER_SECRET
Proxy__VercelSecret=GENERATE_A_DIFFERENT_RANDOM_64_HEX_CHARACTER_SECRET
Database__Provider=Postgres
# Neon Connect > pooled connection string. Paste only the URL (no psql command or quotes).
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-HOST-pooler.neon.tech/neondb?sslmode=require
# Do not set ConnectionStrings__Gather at the same time; it takes precedence over DATABASE_URL.
Storage__Provider=Cloudinary
Cloudinary__CloudName=YOUR_CLOUD_NAME
Cloudinary__ApiKey=YOUR_API_KEY
Cloudinary__ApiSecret=YOUR_API_SECRET
Email__Provider=Brevo
# API key from Brevo's API Keys tab, NOT an SMTP key.
Email__ApiKey=YOUR_BREVO_API_KEY
Email__From=YOUR_VERIFIED_SENDER_EMAIL
Storage__UserQuotaBytes=134217728
Storage__TotalQuotaBytes=1073741824
Storage__MinimumFreeBytes=67108864
Storage__UnattachedHours=24
